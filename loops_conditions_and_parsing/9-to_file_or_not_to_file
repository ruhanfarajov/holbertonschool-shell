#!/usr/bin/env bash
#This is just checking the existence of the file


if [ -e ./school ]; then
	if [ ! -s ./school ]; then echo "school file is empty" ; else echo "school file is not empty"; fi
	if [ -f ./school ]; then echo "school is a regular file"; fi
	echo "school file exists"
else  echo "school file does not exist"

fi	
